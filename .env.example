# NexusHR — copy to .env for docker compose
# cp .env.example .env

# Database
DB_USERNAME=postgres
DB_PASSWORD=admin123

# Security (change in production)
JWT_SECRET=change-me-in-production-min-32-characters-long
NOTIFICATION_INTERNAL_KEY=nexushr-internal-dev-key
LEAVE_INTERNAL_KEY=nexushr-internal-dev-key
EMPLOYEE_INTERNAL_KEY=nexushr-internal-dev-key

# Grafana (monitoring profile)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Frontend API URLs (browser → gateway)
VITE_AUTH_API_URL=http://localhost:8080
VITE_EMPLOYEE_API_URL=http://localhost:8080
VITE_ATTENDANCE_API_URL=http://localhost:8080
VITE_LEAVE_API_URL=http://localhost:8080
VITE_PAYROLL_API_URL=http://localhost:8080
VITE_PERFORMANCE_API_URL=http://localhost:8080
VITE_NOTIFICATION_API_URL=http://localhost:8080
VITE_AI_INSIGHTS_API_URL=http://localhost:8080
