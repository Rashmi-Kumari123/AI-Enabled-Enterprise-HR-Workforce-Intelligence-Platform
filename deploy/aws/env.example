# AWS CLI deployment — copy to your shell or .env.local (never commit real values)

AWS_REGION=ap-south-1
EKS_CLUSTER_NAME=nexushr-prod
IMAGE_TAG=latest
ECR_PREFIX=nexushr

# Configure via `aws configure` — do NOT put keys in this file:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# RDS (for provision-databases.sh)
# DATABASE_URL=postgresql://postgres:PASSWORD@your-rds.region.rds.amazonaws.com:5432/postgres?sslmode=require

# Frontend build (for push-images.sh — set to your ALB / gateway URL)
# VITE_AUTH_API_URL=https://api.yourdomain.com
# VITE_EMPLOYEE_API_URL=https://api.yourdomain.com
# VITE_ATTENDANCE_API_URL=https://api.yourdomain.com
# VITE_LEAVE_API_URL=https://api.yourdomain.com
# VITE_PAYROLL_API_URL=https://api.yourdomain.com
# VITE_PERFORMANCE_API_URL=https://api.yourdomain.com
# VITE_NOTIFICATION_API_URL=https://api.yourdomain.com
# VITE_AI_INSIGHTS_API_URL=https://api.yourdomain.com
